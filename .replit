modules = ["python-3.12", "web"]

[nix]
channel = "stable-24_05"

[[ports]]
localPort = 3000
externalPort = 3001

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 35115
externalPort = 3000

[[ports]]
localPort = 42023
externalPort = 80

[env]
DJANGO_SETTINGS_MODULE = "scoutgine.settings"
PYTHONUNBUFFERED = "1"
